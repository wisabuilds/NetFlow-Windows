<UserControl x:Class="NetFlow.App.Views.ResourcesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:NetFlow.App.Controls"
             xmlns:conv="clr-namespace:NetFlow.App.Converters"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1000">
    <UserControl.Resources>
        <conv:BooleanToVisibilityConverter x:Key="BoolVisConverter" />
    </UserControl.Resources>
    <StackPanel>
        <!-- 1. Network History Graph Card -->
        <TextBlock Text="NETWORK HISTORY" Style="{StaticResource AdwPrefTitle}" />
        <Border Style="{StaticResource AdwGraphCard}" Margin="0,0,0,20">
            <StackPanel>
                <!-- Meta bar: Receiving & Sending speeds + peaks -->
                <Grid Margin="0,0,0,12">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <Border Width="12" Height="12" CornerRadius="3" Background="{StaticResource AdwBlue}" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="Receiving: " Foreground="{StaticResource AdwTextSecondary}" FontSize="13" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding RateRxText}" FontWeight="Bold" FontSize="15" FontFamily="{StaticResource FontMono}" Foreground="{StaticResource AdwTextPrimary}" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding PeakRxText}" FontSize="12" Foreground="{StaticResource AdwTextDim}" VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Border Width="12" Height="12" CornerRadius="3" Background="{StaticResource AdwOrange}" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="Sending: " Foreground="{StaticResource AdwTextSecondary}" FontSize="13" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding RateTxText}" FontWeight="Bold" FontSize="15" FontFamily="{StaticResource FontMono}" Foreground="{StaticResource AdwTextPrimary}" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding PeakTxText}" FontSize="12" Foreground="{StaticResource AdwTextDim}" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>

                <!-- Hardware Accelerated DirectX MILCore Canvas Host -->
                <Border Height="200" CornerRadius="8" Background="#181818" Margin="0,0,0,10" BorderBrush="#14FFFFFF" BorderThickness="1">
                    <controls:TrafficGraphVisualHost x:Name="TrafficGraphHost" />
                </Border>

                <!-- Footer labels -->
                <Grid>
                    <TextBlock Text="60 seconds ago" Foreground="{StaticResource AdwTextDim}" FontSize="12" FontFamily="{StaticResource FontMono}" HorizontalAlignment="Left" />
                    <TextBlock Text="{Binding GraphMaxLabel}" Foreground="{StaticResource AdwTextDim}" FontSize="12" FontFamily="{StaticResource FontMono}" HorizontalAlignment="Center" />
                    <TextBlock Text="Now" Foreground="{StaticResource AdwTextDim}" FontSize="12" FontFamily="{StaticResource FontMono}" HorizontalAlignment="Right" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- 2. Latency & Active Sockets 2-Column Strip -->
        <Grid Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource AdwBoxedList}" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <TextBlock Text="GATEWAY LATENCY" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AdwTextSecondary}" />
                        <Path HorizontalAlignment="Right" VerticalAlignment="Center"
                              Data="M 12,2 A 10,10 0 1 0 22,12 A 10,10 0 1 0 12,2 M 12,6 V 12 L 16,14"
                              Width="14" Height="14" Stretch="Uniform"
                              Stroke="{StaticResource AdwTextDim}" StrokeThickness="2" />
                    </Grid>
                    <TextBlock Grid.Row="1" Text="{Binding StatPing}" FontSize="24" FontWeight="Bold" FontFamily="{StaticResource FontMono}" Foreground="#FFFFFF" Margin="0,6,0,2" />
                    <TextBlock Grid.Row="2" Text="Target: 1.1.1.1 (Cloudflare DNS)" FontSize="11" Foreground="{StaticResource AdwTextDim}" />
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource AdwBoxedList}" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <TextBlock Text="ACTIVE SOCKETS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AdwTextSecondary}" />
                        <Path HorizontalAlignment="Right" VerticalAlignment="Center"
                              Data="M 21,16 V 8 L 12,2 L 3,8 V 16 L 12,22 Z"
                              Width="14" Height="14" Stretch="Uniform"
                              Stroke="{StaticResource AdwBlue}" StrokeThickness="2" />
                    </Grid>
                    <TextBlock Grid.Row="1" Text="{Binding StatSockets}" FontSize="24" FontWeight="Bold" FontFamily="{StaticResource FontMono}" Foreground="{StaticResource AdwBlue}" Margin="0,6,0,2" />
                    <TextBlock Grid.Row="2" Text="Currently open TCP &amp; UDP streams" FontSize="11" Foreground="{StaticResource AdwTextDim}" />
                </Grid>
            </Border>
        </Grid>

        <!-- 3. Data Plan & Budget Card -->
        <Grid Margin="0,0,0,6">
            <TextBlock Text="DATA PLAN &amp; BUDGET" Style="{StaticResource AdwPrefTitle}" VerticalAlignment="Center" />
            <Button Style="{StaticResource AdwButton}"
                    Content="Configure Limit"
                    Command="{Binding ConfigureQuotaCommand}"
                    HorizontalAlignment="Right"
                    Padding="10,4" FontSize="11" />
        </Grid>

        <Border Style="{StaticResource AdwGraphCard}" Margin="0,0,0,20">
            <StackPanel>
                <!-- Inline Quota Config Panel -->
                <Border Visibility="{Binding IsEditingQuota, Converter={StaticResource BoolVisConverter}}"
                        Background="{StaticResource AdwCardBgElevated}"
                        CornerRadius="8"
                        BorderBrush="{StaticResource AdwCardBorder}"
                        BorderThickness="1"
                        Padding="14,12"
                        Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Set Monthly Allowance Limit (GB):" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AdwTextSecondary}" Margin="0,0,0,8" />
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <!-- Presets -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource AdwButton}" Content="25 GB" Command="{Binding SetPresetQuotaCommand}" CommandParameter="25" Padding="8,3" FontSize="11" Margin="0,0,6,0" />
                                <Button Style="{StaticResource AdwButton}" Content="50 GB" Command="{Binding SetPresetQuotaCommand}" CommandParameter="50" Padding="8,3" FontSize="11" Margin="0,0,6,0" />
                                <Button Style="{StaticResource AdwButton}" Content="100 GB" Command="{Binding SetPresetQuotaCommand}" CommandParameter="100" Padding="8,3" FontSize="11" Margin="0,0,6,0" />
                                <Button Style="{StaticResource AdwButton}" Content="250 GB" Command="{Binding SetPresetQuotaCommand}" CommandParameter="250" Padding="8,3" FontSize="11" Margin="0,0,12,0" />
                            </StackPanel>
                            <!-- Custom Input + Actions -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBox Style="{StaticResource AdwTextBox}" Text="{Binding QuotaInputGb, UpdateSourceTrigger=PropertyChanged}" Tag="e.g. 50" Width="70" Height="28" Margin="0,0,6,0" ToolTip="GB" />
                                <TextBlock Text="GB" Foreground="{StaticResource AdwTextDim}" FontSize="12" VerticalAlignment="Center" Margin="0,0,12,0" />
                                <Button Style="{StaticResource AdwSuggestedButton}" Content="Save Limit" Command="{Binding SaveQuotaCommand}" Height="28" Padding="12,0" FontSize="11" Margin="0,0,6,0" />
                                <Button Style="{StaticResource AdwDestructiveButton}" Content="Remove" Command="{Binding RemoveQuotaCommand}" Height="28" Padding="10,0" FontSize="11" Margin="0,0,6,0" />
                                <Button Style="{StaticResource AdwButton}" Content="Cancel" Command="{Binding CancelQuotaEditCommand}" Height="28" Padding="10,0" FontSize="11" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Grid Margin="0,0,0,10">
                    <StackPanel HorizontalAlignment="Left">
                        <TextBlock Text="{Binding QuotaTitle}" FontWeight="Bold" FontSize="14" Foreground="#FFFFFF" />
                        <TextBlock Text="{Binding QuotaSubtitle}" FontSize="12" Foreground="{StaticResource AdwTextSecondary}" Margin="0,2,0,0" />
                    </StackPanel>
                    <Border HorizontalAlignment="Right">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource AdwBadgePillBlue}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding BurnStatus}" Value="warning">
                                        <Setter Property="Background" Value="{StaticResource AdwYellowDim}" />
                                        <Setter Property="BorderBrush" Value="{StaticResource AdwYellow}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding BurnStatus}" Value="critical">
                                        <Setter Property="Background" Value="{StaticResource AdwRedDim}" />
                                        <Setter Property="BorderBrush" Value="{StaticResource AdwRed}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding BurnStatus}" Value="exceeded">
                                        <Setter Property="Background" Value="{StaticResource AdwRedDim}" />
                                        <Setter Property="BorderBrush" Value="{StaticResource AdwRed}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding BurnStatus}" Value="unconfigured">
                                        <Setter Property="Background" Value="{StaticResource AdwCardBgElevated}" />
                                        <Setter Property="BorderBrush" Value="{StaticResource AdwCardBorder}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding QuotaPercentText}" FontWeight="Bold" FontSize="12">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource AdwBlue}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding BurnStatus}" Value="warning">
                                            <Setter Property="Foreground" Value="{StaticResource AdwYellow}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding BurnStatus}" Value="critical">
                                            <Setter Property="Foreground" Value="{StaticResource AdwRed}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding BurnStatus}" Value="exceeded">
                                            <Setter Property="Foreground" Value="{StaticResource AdwRed}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding BurnStatus}" Value="unconfigured">
                                            <Setter Property="Foreground" Value="{StaticResource AdwTextDim}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                </Grid>

                <!-- Progress Bar with dynamic BurnStatus coloring -->
                <Border Height="8" CornerRadius="4" Background="{StaticResource AdwCardBgElevated}" Margin="0,0,0,16" ClipToBounds="True">
                    <ProgressBar Value="{Binding QuotaFillPercent}" Maximum="100" Height="8" Background="Transparent" BorderThickness="0">
                        <ProgressBar.Style>
                            <Style TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
                                <Setter Property="Foreground" Value="{StaticResource AdwBlue}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding BurnStatus}" Value="warning">
                                        <Setter Property="Foreground" Value="{StaticResource AdwYellow}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding BurnStatus}" Value="critical">
                                        <Setter Property="Foreground" Value="{StaticResource AdwRed}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding BurnStatus}" Value="exceeded">
                                        <Setter Property="Foreground" Value="{StaticResource AdwRed}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ProgressBar.Style>
                    </ProgressBar>
                </Border>

                <!-- 4-Column Forecast details -->
                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="PACE STATUS" FontSize="11" Foreground="{StaticResource AdwTextDim}" />
                        <Border HorizontalAlignment="Left" Margin="0,4,0,0">
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource AdwBadgePill}">
                                    <Setter Property="Background" Value="{StaticResource AdwCardBgElevated}" />
                                    <Setter Property="BorderBrush" Value="{StaticResource AdwCardBorder}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding BurnStatus}" Value="healthy">
                                            <Setter Property="Background" Value="{StaticResource AdwGreenDim}" />
                                            <Setter Property="BorderBrush" Value="{StaticResource AdwGreen}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding BurnStatus}" Value="warning">
                                            <Setter Property="Background" Value="{StaticResource AdwYellowDim}" />
                                            <Setter Property="BorderBrush" Value="{StaticResource AdwYellow}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding BurnStatus}" Value="critical">
                                            <Setter Property="Background" Value="{StaticResource AdwRedDim}" />
                                            <Setter Property="BorderBrush" Value="{StaticResource AdwRed}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding BurnStatus}" Value="exceeded">
                                            <Setter Property="Background" Value="{StaticResource AdwRedDim}" />
                                            <Setter Property="BorderBrush" Value="{StaticResource AdwRed}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding PaceStatus}" FontSize="11" FontWeight="SemiBold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource AdwTextDim}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding BurnStatus}" Value="healthy">
                                                <Setter Property="Foreground" Value="{StaticResource AdwGreen}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding BurnStatus}" Value="warning">
                                                <Setter Property="Foreground" Value="{StaticResource AdwYellow}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding BurnStatus}" Value="critical">
                                                <Setter Property="Foreground" Value="{StaticResource AdwRed}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding BurnStatus}" Value="exceeded">
                                                <Setter Property="Foreground" Value="{StaticResource AdwRed}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="SAFE DAILY BUDGET" FontSize="11" Foreground="{StaticResource AdwTextDim}" />
                        <TextBlock Text="{Binding SafeDailyBudget}" FontSize="13" FontWeight="Bold" FontFamily="{StaticResource FontMono}" Foreground="{StaticResource AdwBlue}" Margin="0,6,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="PROJECTED TOTAL" FontSize="11" Foreground="{StaticResource AdwTextDim}" />
                        <TextBlock Text="{Binding ProjectedTotal}" FontSize="13" FontWeight="SemiBold" FontFamily="{StaticResource FontMono}" Foreground="{StaticResource AdwTextPrimary}" Margin="0,6,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="3">
                        <TextBlock Text="ESTIMATED CAP DATE" FontSize="11" Foreground="{StaticResource AdwTextDim}" />
                        <TextBlock Text="{Binding EstimatedExhaustionDate}" FontSize="13" FontWeight="SemiBold" FontFamily="{StaticResource FontMono}" Foreground="{StaticResource AdwYellow}" Margin="0,6,0,0" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- 4. Active Network Interfaces List -->
        <TextBlock Text="ACTIVE NETWORK INTERFACES" Style="{StaticResource AdwPrefTitle}" />
        <Border Style="{StaticResource AdwBoxedList}" Padding="4,0" Margin="0,0,0,20">
            <ItemsControl ItemsSource="{Binding Interfaces}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderThickness="0,0,0,1" BorderBrush="#0DFFFFFF" Padding="14,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13" Foreground="#FFFFFF" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="↓ " Foreground="{StaticResource AdwBlue}" FontFamily="{StaticResource FontMono}" FontWeight="Bold" />
                                    <TextBlock Text="{Binding RxSpeedText}" FontFamily="{StaticResource FontMono}" Foreground="{StaticResource AdwTextPrimary}" Margin="0,0,16,0" />
                                    <TextBlock Text="↑ " Foreground="{StaticResource AdwOrange}" FontFamily="{StaticResource FontMono}" FontWeight="Bold" />
                                    <TextBlock Text="{Binding TxSpeedText}" FontFamily="{StaticResource FontMono}" Foreground="{StaticResource AdwTextPrimary}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <TextBlock Text="Total: " Foreground="{StaticResource AdwTextDim}" FontSize="12" VerticalAlignment="Center" Margin="0,0,4,0" />
                                    <TextBlock Text="↓ " Foreground="{StaticResource AdwBlue}" FontSize="11" FontFamily="{StaticResource FontMono}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding TotalRxText}" FontFamily="{StaticResource FontMono}" FontSize="12" Foreground="{StaticResource AdwTextSecondary}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <TextBlock Text="↑ " Foreground="{StaticResource AdwOrange}" FontSize="11" FontFamily="{StaticResource FontMono}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding TotalTxText}" FontFamily="{StaticResource FontMono}" FontSize="12" Foreground="{StaticResource AdwTextSecondary}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <!-- 5. Desktop & System Settings -->
        <TextBlock Text="DESKTOP &amp; SYSTEM SETTINGS" Style="{StaticResource AdwPrefTitle}" />
        <Border Style="{StaticResource AdwBoxedList}" Margin="0,0,0,24">
            <StackPanel>
                <Border BorderThickness="0,0,0,1" BorderBrush="{StaticResource AdwCardBorder}" Padding="16,14">
                    <Grid>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Launch NetFlow on Windows Startup" FontWeight="Bold" FontSize="14" Foreground="#FFFFFF" />
                            <TextBlock Text="Automatically starts NetFlow minimized in background upon user login" FontSize="12" Foreground="{StaticResource AdwTextSecondary}" Margin="0,2,0,0" />
                        </StackPanel>
                        <CheckBox HorizontalAlignment="Right" VerticalAlignment="Center" IsChecked="{Binding LaunchOnStartup, Mode=TwoWay}" />
                    </Grid>
                </Border>
                <Border Padding="16,14">
                    <Grid>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Desktop Toast Notifications" FontWeight="Bold" FontSize="14" Foreground="#FFFFFF" />
                            <TextBlock Text="Trigger native Windows alerts for high-risk threats and data quota crossings" FontSize="12" Foreground="{StaticResource AdwTextSecondary}" Margin="0,2,0,0" />
                        </StackPanel>
                        <CheckBox HorizontalAlignment="Right" VerticalAlignment="Center" IsChecked="{Binding ToastNotifications, Mode=TwoWay}" />
                    </Grid>
                </Border>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>