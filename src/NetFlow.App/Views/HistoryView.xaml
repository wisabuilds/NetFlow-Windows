<UserControl x:Class="NetFlow.App.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1000">
    <StackPanel>
        <!-- 1. Data Usage Summary Boxed List -->
        <TextBlock Text="DATA USAGE SUMMARY" Style="{StaticResource AdwPrefTitle}" />
        <Border Style="{StaticResource AdwBoxedList}" Margin="0,0,0,20">
            <StackPanel>
                <!-- Export Row -->
                <Border BorderThickness="0,0,0,1" BorderBrush="{StaticResource AdwCardBorder}" Padding="16,12">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="M 21,15 V 19 C 21,20.1 20.1,21 19,21 H 5 C 3.9,21 3,20.1 3,19 V 15 M 7,10 L 12,15 L 17,10 M 12,15 V 3"
                                  Width="18" Height="18" Stretch="Uniform"
                                  Stroke="{StaticResource AdwTextSecondary}" StrokeThickness="2" Margin="0,0,12,0" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Export Network Data" FontWeight="Bold" FontSize="14" Foreground="#FFFFFF" />
                                <TextBlock Text="Download bandwidth and process statistics for analysis" FontSize="12" Foreground="{StaticResource AdwTextDim}" Margin="0,2,0,0" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Style="{StaticResource AdwButton}" Content="Daily CSV" Command="{Binding ExportDailyCsvCommand}" Height="28" Padding="10,0" FontSize="11" Margin="0,0,8,0" />
                            <Button Style="{StaticResource AdwButton}" Content="Apps CSV" Command="{Binding ExportAppsCsvCommand}" Height="28" Padding="10,0" FontSize="11" Margin="0,0,8,0" />
                            <Button Style="{StaticResource AdwButton}" Content="JSON" Command="{Binding ExportJsonCommand}" Height="28" Padding="10,0" FontSize="11" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Today Row -->
                <Border BorderThickness="0,0,0,1" BorderBrush="{StaticResource AdwCardBorder}" Padding="16,14">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="M 12,2 A 10,10 0 1 0 22,12 A 10,10 0 1 0 12,2 M 12,6 V 12 L 14,14"
                                  Width="18" Height="18" Stretch="Uniform"
                                  Stroke="{StaticResource AdwBlue}" StrokeThickness="2" Margin="0,0,12,0" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Today" FontWeight="Bold" FontSize="14" Foreground="#FFFFFF" />
                                <TextBlock Text="Since 00:00 midnight" FontSize="12" Foreground="{StaticResource AdwTextDim}" Margin="0,2,0,0" />
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Text="{Binding TodayText}" FontWeight="Bold" FontSize="16" FontFamily="{StaticResource FontMono}" Foreground="{StaticResource AdwBlue}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <!-- Yesterday Row -->
                <Border BorderThickness="0,0,0,1" BorderBrush="{StaticResource AdwCardBorder}" Padding="16,14">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="M 3,4 H 21 V 22 H 3 Z M 16,2 V 6 M 8,2 V 6 M 3,10 H 21"
                                  Width="18" Height="18" Stretch="Uniform"
                                  Stroke="{StaticResource AdwTextSecondary}" StrokeThickness="2" Margin="0,0,12,0" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Yesterday" FontWeight="Bold" FontSize="14" Foreground="#FFFFFF" />
                                <TextBlock Text="Full previous 24 hours" FontSize="12" Foreground="{StaticResource AdwTextDim}" Margin="0,2,0,0" />
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Text="{Binding YesterdayText}" FontWeight="Bold" FontSize="15" FontFamily="{StaticResource FontMono}" Foreground="{StaticResource AdwTextPrimary}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <!-- Last 7 Days Row -->
                <Border BorderThickness="0,0,0,1" BorderBrush="{StaticResource AdwCardBorder}" Padding="16,14">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="M 23,6 L 13.5,15.5 L 8.5,10.5 L 1,18 M 17,6 H 23 V 12"
                                  Width="18" Height="18" Stretch="Uniform"
                                  Stroke="{StaticResource AdwTextSecondary}" StrokeThickness="2" Margin="0,0,12,0" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Last 7 Days" FontWeight="Bold" FontSize="14" Foreground="#FFFFFF" />
                                <TextBlock Text="Rolling weekly consumption" FontSize="12" Foreground="{StaticResource AdwTextDim}" Margin="0,2,0,0" />
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Text="{Binding WeekText}" FontWeight="Bold" FontSize="15" FontFamily="{StaticResource FontMono}" Foreground="{StaticResource AdwTextPrimary}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <!-- Last 30 Days Row -->
                <Border Padding="16,14">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="M 12,2 V 22 M 17,5 H 9.5 A 3.5,3.5 0 0 0 9.5,12 H 14.5 A 3.5,3.5 0 0 1 14.5,19 H 6"
                                  Width="18" Height="18" Stretch="Uniform"
                                  Stroke="{StaticResource AdwGreen}" StrokeThickness="2" Margin="0,0,12,0" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Last 30 Days" FontWeight="Bold" FontSize="14" Foreground="#FFFFFF" />
                                <TextBlock Text="Monthly total consumption" FontSize="12" Foreground="{StaticResource AdwTextDim}" Margin="0,2,0,0" />
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Text="{Binding MonthText}" FontWeight="Bold" FontSize="16" FontFamily="{StaticResource FontMono}" Foreground="{StaticResource AdwGreen}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                </Border>
            </StackPanel>
        </Border>

        <!-- 2. Daily Consumption History Table -->
        <TextBlock Text="DAILY CONSUMPTION HISTORY" Style="{StaticResource AdwPrefTitle}" />
        <Border Style="{StaticResource AdwBoxedList}" MaxHeight="250" Margin="0,0,0,20">
            <DataGrid ItemsSource="{Binding DailyRecords}" Style="{StaticResource AdwDataGrid}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="DATE" Binding="{Binding Date}" Width="150">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontFamily" Value="{StaticResource FontMono}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter Property="Foreground" Value="{StaticResource AdwTextPrimary}" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="DOWNLOADED (RX)" Binding="{Binding RxHuman}" Width="*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontFamily" Value="{StaticResource FontMono}" />
                                <Setter Property="Foreground" Value="{StaticResource AdwBlue}" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="UPLOADED (TX)" Binding="{Binding TxHuman}" Width="*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontFamily" Value="{StaticResource FontMono}" />
                                <Setter Property="Foreground" Value="{StaticResource AdwOrange}" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="TOTAL CONSUMPTION" Binding="{Binding TotalHuman}" Width="*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontFamily" Value="{StaticResource FontMono}" />
                                <Setter Property="FontWeight" Value="Bold" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- 3. Cumulative Top Applications Table -->
        <TextBlock Text="CUMULATIVE TOP APPLICATIONS (LAST 24H)" Style="{StaticResource AdwPrefTitle}" />
        <Border Style="{StaticResource AdwBoxedList}" MaxHeight="250" Margin="0,0,0,24">
            <DataGrid ItemsSource="{Binding TopApps}" Style="{StaticResource AdwDataGrid}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="APPLICATION NAME" Binding="{Binding Name}" Width="*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="RECEIVED (DOWNLOAD)" Binding="{Binding RxHuman}" Width="170">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontFamily" Value="{StaticResource FontMono}" />
                                <Setter Property="Foreground" Value="{StaticResource AdwBlue}" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="SENT (UPLOAD)" Binding="{Binding TxHuman}" Width="170">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontFamily" Value="{StaticResource FontMono}" />
                                <Setter Property="Foreground" Value="{StaticResource AdwOrange}" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="TOTAL CONSUMED" Binding="{Binding TotalHuman}" Width="170">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontFamily" Value="{StaticResource FontMono}" />
                                <Setter Property="FontWeight" Value="Bold" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </StackPanel>
</UserControl>